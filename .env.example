# order-service DB
ORDER_DB_NAME=orderdb
ORDER_DB_USER=order
ORDER_DB_PASSWORD=orderpw
ORDER_DB_ROOT_PASSWORD=rootpw
ORDER_DB_PORT=3306

# order-service
ORDER_SERVICE_PORT=8080

# product-service DB
PRODUCT_DB_NAME=productdb
PRODUCT_DB_USER=product
PRODUCT_DB_PASSWORD=productpw
PRODUCT_DB_ROOT_PASSWORD=rootpw
PRODUCT_DB_PORT=3307

# product-service
PRODUCT_SERVICE_PORT=8081

# payment-service DB
PAYMENT_DB_NAME=paymentdb
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=paymentpw
PAYMENT_DB_ROOT_PASSWORD=rootpw
PAYMENT_DB_PORT=3308

# payment-service
PAYMENT_SERVICE_PORT=8082
PAYMENT_APPROVAL_LIMIT=1000000
# 부하실험용 결제 처리 지연(ms)
PAYMENT_PROCESSING_DELAY_MS=0

# Kafka
KAFKA_EXTERNAL_PORT=9094
# 부하테스트용 payment-commands 파티션 수 (평소 1, 부하테스트때 4 등)
PAYMENT_COMMANDS_PARTITIONS=1
# 부하테스트용 payment-commands 리스너 컨슈머 스레드 수 (파티션과 1:1, 평소 1)
PAYMENT_COMMANDS_CONCURRENCY=1

# gateway-service
GATEWAY_PORT=8000

# zipkin
ZIPKIN_PORT=9411

# monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
KAFKA_EXPORTER_PORT=9308