      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (job, outcome) (rate(http_server_requests_seconds_count{job=~\"$job\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[1m]))", "legendFormat": "{{job}} {{outcome}}" }
      ]
    },
    {
